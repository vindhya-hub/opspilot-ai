# OpsPilot AI configuration. Copy to `.env` (git-ignored) and fill in only what you need:
#   cp .env.example .env
# Every variable is optional. Empty values fall back to the defaults shown in the comments.
# The same `.env` is read by the API (pydantic-settings) and by `docker compose` for
# ${VAR} substitution. Nothing in here is a secret except OPSPILOT_LLM_API_KEY.

# --- Model, knowledge base and storage (paths relative to the working directory) ----------
# Directory with trained artifacts from `python -m opspilot.train`. Default: artifacts
OPSPILOT_ARTIFACTS_DIR=
# Directory of markdown runbooks used for cited guidance. Default: kb
OPSPILOT_KB_DIR=
# Review queue backend: sqlite | memory. Default: sqlite
OPSPILOT_QUEUE_BACKEND=
# SQLite file for the review queue. Default: data/review_queue.db
OPSPILOT_QUEUE_DB_PATH=

# --- Routing -------------------------------------------------------------------------------
# Risk >= this routes to human review (0-1]. Default: the F1-optimal threshold tuned on
# validation data during training (stored with the model).
OPSPILOT_RISK_THRESHOLD=
# Lower edge of the "medium" risk band [0-1]. Default: 60% of the review threshold.
OPSPILOT_MEDIUM_THRESHOLD=

# --- Guidance drafting ---------------------------------------------------------------------
# Runbook passages retrieved per ticket (1-10). Default: 3
OPSPILOT_RETRIEVAL_TOP_K=
# Draft composer: template (offline, default) | llm (optional hook, see below)
OPSPILOT_COMPOSER=
# Optional LLM hook, used only when OPSPILOT_COMPOSER=llm. All three are then required;
# startup fails with a clear error if any is missing. Any OpenAI-compatible
# /chat/completions endpoint works, e.g. https://llm.example.com/v1
OPSPILOT_LLM_BASE_URL=
OPSPILOT_LLM_MODEL=
# SECRET. Provide it through your shell, CI secret store or secret manager in production.
# Never commit a real value; `.env` is git-ignored.
OPSPILOT_LLM_API_KEY=
# Seconds before an LLM call is abandoned and the template draft is used. Default: 15
OPSPILOT_LLM_TIMEOUT_SECONDS=

# --- HTTP server ---------------------------------------------------------------------------
# Bind address and port for `python -m opspilot.api`. Defaults: 127.0.0.1 and 8000
# (the Docker image sets OPSPILOT_HOST=0.0.0.0 so the port can be published).
OPSPILOT_HOST=
OPSPILOT_PORT=
# critical | error | warning | info | debug. Default: info
OPSPILOT_LOG_LEVEL=
# Comma-separated browser origins allowed by CORS.
# Default: http://localhost:5173,http://127.0.0.1:5173 (Vite dev server).
# With docker compose the default is the dashboard container: http://localhost:8080
OPSPILOT_CORS_ORIGINS=
# Requests with a larger declared body are rejected with 413. Default: 1048576 (1 MiB)
OPSPILOT_MAX_REQUEST_BYTES=
# CPU threads for PyTorch inference. Default: 1
OPSPILOT_TORCH_THREADS=

# --- docker compose only -------------------------------------------------------------------
# Host ports published by docker-compose.yml. Defaults: 8000, 8080 and 9090
API_PORT=
DASHBOARD_PORT=
PROMETHEUS_PORT=
# API URL baked into the dashboard image at build time (public, not a secret).
# Default: http://localhost:8000
VITE_API_URL=

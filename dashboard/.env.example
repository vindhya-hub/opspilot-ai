# Dashboard configuration. Copy to `.env` (git-ignored) for `npm run dev` / `npm run build`:
#   cp .env.example .env
#
# Only VITE_* variables reach the browser, and they are embedded in the built JavaScript,
# so they are public by design: never put a secret, token or key in a VITE_* variable.

# Base URL of the OpsPilot API as seen from the browser (required). The API must allow
# the dashboard's origin via OPSPILOT_CORS_ORIGINS.
VITE_API_URL=http://localhost:8000
